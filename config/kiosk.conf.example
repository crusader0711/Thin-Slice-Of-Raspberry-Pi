# Thin-Slice-Of-Raspberry-Pi runtime config — installed to /etc/kiosk.conf by
# src/pi/provision.sh (mode 0600, owner kiosk). Never commit a filled-in copy.
KASM_HOST="<SERVER_IP_OR_FQDN>:<PORT>"
MODE="persistent"            # persistent | cast
CAST_KEY=""                  # cast mode only
KASM_USER_ID=""              # persistent mode: Kasm user UUID
KASM_API_KEY=""              # persistent mode: key scoped to "Users Auth Session" ONLY
KASM_API_SECRET=""           # persistent mode
IGNORE_TLS="0"               # 1 = --ignore-certificate-errors (LAN-only stopgap)
