#!/usr/bin/env bash
# Installed by `make setup` (git config core.hooksPath hooks/). Lint + secret floor.
set -euo pipefail
./scripts/lint.sh
if command -v gitleaks >/dev/null; then
  gitleaks protect --staged --no-banner
else
  # Fallback secret grep: obvious credential assignments with non-placeholder values
  if git diff --cached -U0 | grep -E '^\+.*((API_KEY|API_SECRET|PASSWORD|TOKEN)="[^<"]{8,})'; then
    echo "pre-commit: possible secret staged — use placeholders or .env"; exit 1
  fi
fi
